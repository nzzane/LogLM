# ══════════════════════════════════════════════════════════════════════════════
#  LogLM Configuration — copy to .env and fill in values
# ══════════════════════════════════════════════════════════════════════════════

POSTGRES_PASSWORD=change_me_strong_password
SECRET_KEY=change_me_random_32_chars

# ── Discord ──────────────────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# ── Ollama LLM ───────────────────────────────────────────────────────────────
# For local Docker Ollama (NVIDIA GPU):
#   OLLAMA_URL=http://ollama:11434
# For host-native Ollama (Mac / external server):
#   OLLAMA_URL=http://host.docker.internal:11434
# For a remote Ollama instance:
#   OLLAMA_URL=http://192.168.1.50:11434
OLLAMA_URL=http://host.docker.internal:11434

# Model selection:
#   Mac M4 (recommended):     llama3.2:3b       (~2 GB, fast on Metal)
#   NVIDIA 8 GB (default):    llama3.1:8b-instruct-q4_K_M  (~4.7 GB VRAM)
#   Lighter NVIDIA option:    mistral:7b-instruct-q4_K_M   (~4.1 GB VRAM)
OLLAMA_MODEL=llama3.2:3b

# ── Web UI ───────────────────────────────────────────────────────────────────
WEB_PORT=8080

# ── LibreNMS integration (optional) ──────────────────────────────────────────
LIBRENMS_URL=
LIBRENMS_TOKEN=

# ── SNMP polling ─────────────────────────────────────────────────────────────
# Comma-separated targets: host:port or just host (default port 161)
# Example: 192.168.1.1,192.168.1.2:161,unifi-ap-office
SNMP_TARGETS=
SNMP_COMMUNITY=public
SNMP_POLL_INTERVAL=60

# ── Tuning ───────────────────────────────────────────────────────────────────
# Alert de-duplication cooldown per service (seconds)
ALERT_COOLDOWN_SECONDS=300
# How often the analyzer checks for anomalies (seconds)
ANALYSIS_INTERVAL_SECONDS=60
# How often the memory summariser runs (seconds)
MEMORY_INTERVAL_SECONDS=300

# ── Ollama concurrency / persistence ─────────────────────────────────────────
OLLAMA_MAX_CONCURRENT=2
OLLAMA_KEEP_ALIVE=30m

# ── Three-tier LLM configuration ─────────────────────────────────────────────
#
# TIER 1 — Fast Categorizer (processor service)
#   Per-event keep/store/drop. Very cheap: ~32 tokens/event, cached by signature.
#   Recommended models: llama3.2:1b, qwen2.5:0.5b
#   Set PROCESSOR_USE_FAST_LLM=0 to disable and use static rules only (default).
OLLAMA_MODEL_FAST=llama3.2:1b
PROCESSOR_USE_FAST_LLM=0
PROCESSOR_FAST_CONCURRENT=4
PROCESSOR_FAST_TIMEOUT=4

# TIER 2 — Correlation Analyzer (analyzer service)
#   Batched cross-domain analysis. 120–400 events/call.
#   Recommended: llama3.1:8b-instruct-q4_K_M, qwen2.5:14b-instruct-q4_K_M
OLLAMA_MODEL_DEEP=llama3.1:8b-instruct-q4_K_M

# TIER 3 — Forensic Engine (analyzer service, background loop)
#   Deep causal-chain analysis for critical escalated alerts. Async — no hot-path impact.
#   Set T3_ENABLED=1 and configure a large model to activate.
#   Recommended: qwen2.5:32b-instruct-q4_K_M, llama3.3:70b-instruct-q4_K_M
#   Or use an OpenAI-compatible API endpoint (set T3_API_KEY too).
OLLAMA_MODEL_T3=
T3_ENABLED=0
T3_ESCALATION_THRESHOLD=critical   # critical | high — minimum severity to trigger T3
T3_CORRELATION_WINDOW=300          # seconds of event history to gather for context
T3_MAX_TOKENS=2048                 # max tokens in T3 forensic report response
T3_API_KEY=                        # optional API key for OpenAI-compatible T3 endpoint

# ── Per-tier Ollama URLs (leave blank to use OLLAMA_URL for all) ──────────────
# Useful when running separate Ollama instances for different model sizes.
# If blank, each tier inherits the value of OLLAMA_URL above.
#
# Deployment Mode examples:
#
#   SINGLE INSTANCE (default):
#     Leave all OLLAMA_URL_T* blank — all tiers use OLLAMA_URL.
#
#   DUAL INSTANCE (fast T1 + deep T2/T3):
#     OLLAMA_URL_T1=http://192.168.1.50:11434   # host running small model
#     OLLAMA_URL_T2=http://192.168.1.51:11434   # host running large model
#     (OLLAMA_URL_T3 inherits from T2 if left blank)
#
#   FULL THREE-TIER (dedicated instance per tier):
#     OLLAMA_URL_T1=http://gpu1:11434
#     OLLAMA_URL_T2=http://gpu2:11434
#     OLLAMA_URL_T3=http://gpu3:11434
#
#   CLOUD HYBRID (local T1+T2, cloud API for T3 forensics):
#     OLLAMA_URL_T3=https://api.groq.com/openai/v1
#     OLLAMA_MODEL_T3=meta-llama/llama-3.3-70b-instruct
#     T3_API_KEY=sk-...
#
OLLAMA_URL_T1=
OLLAMA_URL_T2=
OLLAMA_URL_T3=
OLLAMA_URL_CHAT=

# ── External storage ─────────────────────────────────────────────────────────
# Bind-mount host paths so postgres/loki/redis don't fill the docker image layer.
# Point this at a big external/NAS disk: e.g. /mnt/loglm or /srv/loglm
STORAGE_PATH=./data

# ── Time / NTP ───────────────────────────────────────────────────────────────
# IANA timezone applied to every container (logs, scheduler, UI render).
# Examples: UTC, Europe/London, America/New_York, Australia/Sydney
TZ=UTC

# Preferred NTP server. The host OS is responsible for actually syncing the
# clock — containers inherit the host time. LogLM displays this value on the
# Retention page so admins know which server should be authoritative.
NTP_SERVER=pool.ntp.org
